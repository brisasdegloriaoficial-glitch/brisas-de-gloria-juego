[sub_resource type="Shader" id=31]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 color_oro : hint_color = vec4(1.0, 0.82, 0.32, 1.0);
uniform float metalico : hint_range(0.0, 1.0) = 1.0;
uniform float rugosidad : hint_range(0.0, 1.0) = 0.06;
uniform float brillo_borde : hint_range(0.0, 1.0) = 0.55;
uniform vec4 color_borde : hint_color = vec4(1.0, 0.96, 0.75, 1.0);
uniform float intensidad_especular : hint_range(0.0, 1.0) = 0.9;

void fragment() {
	ALBEDO = color_oro.rgb;
	METALLIC = metalico;
	ROUGHNESS = rugosidad;
	SPECULAR = intensidad_especular;
	RIM = brillo_borde;
	RIM_TINT = 0.65;
}"

